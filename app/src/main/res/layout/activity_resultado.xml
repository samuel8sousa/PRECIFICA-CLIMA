<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seu preço, sem achismo."
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Prévia visual com valores ilustrativos"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/txtResultadoCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cliente"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"/>

        <TextView
            android:id="@+id/txtResultadoServico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Serviço"
            android:textColor="@color/text_secondary"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMPOSIÇÃO DEMONSTRATIVA"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Mão de obra: R$ 140,00"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Materiais: R$ 220,00"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Deslocamento: R$ 26,40"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Outros custos: R$ 20,00"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Custo total: R$ 406,40"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/primary_dark"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_hero">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREÇO RECOMENDADO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="R$ 478,12"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/accent_lime"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Exemplo com margem de 15%"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnEditarOrcamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Voltar ao formulário"/>

        <Button
            android:id="@+id/btnSalvarOrcamento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Salvar orçamento"
            android:backgroundTint="@color/primary_teal"/>

    </LinearLayout>
</ScrollView>
