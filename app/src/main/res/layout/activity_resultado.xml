<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 1. TÍTULO PRINCIPAL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seu preço, sem achismo."
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <!-- 2. DESCRIÇÃO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Confira os custos e o preço recomendado para este serviço."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"/>

        <!-- 3. CLIENTE -->

        <TextView
            android:id="@+id/txtResultadoCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nome do cliente"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <!-- 4. TIPO DE SERVIÇO -->

        <TextView
            android:id="@+id/txtResultadoServico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tipo de serviço"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"/>

        <!-- 5. CARD: COMPOSIÇÃO DOS CUSTOS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMPOSIÇÃO DO PREÇO"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary"/>

            <!-- Mão de obra -->

            <TextView
                android:id="@+id/txtMaoObra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Mão de obra: --"
                android:textSize="15sp"
                android:textColor="@color/text_primary"/>

            <!-- Materiais -->

            <TextView
                android:id="@+id/txtMateriaisResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Materiais: --"
                android:textSize="15sp"
                android:textColor="@color/text_primary"/>

            <!-- Deslocamento -->

            <TextView
                android:id="@+id/txtDeslocamentoResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Deslocamento: --"
                android:textSize="15sp"
                android:textColor="@color/text_primary"/>

            <!-- Outros custos -->

            <TextView
                android:id="@+id/txtOutrosResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Outros custos: --"
                android:textSize="15sp"
                android:textColor="@color/text_primary"/>

            <!-- Custo total -->

            <TextView
                android:id="@+id/txtCustoTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Custo total: --"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"/>

        </LinearLayout>

        <!-- 6. CARD: PREÇO RECOMENDADO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_hero">

            <!-- Título do resultado -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREÇO RECOMENDADO"
                android:textColor="@android:color/white"
                android:textSize="13sp"/>

            <!-- Valor calculado -->

            <TextView
                android:id="@+id/txtPrecoRecomendado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="R$ --"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/accent_lime"/>

            <!-- Margem utilizada -->

            <TextView
                android:id="@+id/txtMargemResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Margem aplicada: --"
                android:textColor="@android:color/white"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- 7. BOTÃO VOLTAR -->

        <Button
            android:id="@+id/btnEditarOrcamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Voltar ao formulário"
            android:backgroundTint="@color/blue_soft"
            android:textColor="@color/text_primary"/>

        <!-- 8. BOTÃO SALVAR -->

        <Button
            android:id="@+id/btnSalvarOrcamento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Salvar orçamento"
            android:backgroundTint="@color/primary_teal"
            android:textColor="@color/text_on_teal"/>

    </LinearLayout>

</ScrollView>
