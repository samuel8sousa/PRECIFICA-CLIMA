<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:padding="18dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtCliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nome do cliente"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/text_primary"/>

    <TextView
        android:id="@+id/txtServico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tipo de serviço"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/txtValor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="R$ 0,00"
        android:textStyle="bold"
        android:textColor="@color/primary_teal"
        android:textSize="22sp"/>


    <!-- BOTÕES DE AÇÃO DO ORÇAMENTO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- BOTÃO EDITAR -->
        <Button
            android:id="@+id/btnEditar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Editar"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/text_on_teal"
            android:backgroundTint="@color/primary_teal"/>

        <!-- BOTÃO VER ROTA -->
        <Button
            android:id="@+id/btnVerRota"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Ver rota"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/text_on_teal"
            android:backgroundTint="@color/primary_teal"/>

    </LinearLayout>
    <!-- COMPARTILHAR ORÇAMENTO -->
    <Button
        android:id="@+id/btnCompartilhar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Enviar pelo WhatsApp"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="@color/text_on_teal"
        android:backgroundTint="@color/primary_teal"/>

    <!-- EXCLUIR ORÇAMENTO -->
    <Button
        android:id="@+id/btnExcluir"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Excluir orçamento"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:backgroundTint="#B3261E"/>


    <Button
        android:id="@+id/btnMarcarRecebido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Marcar como recebido"
        android:backgroundTint="@color/primary_teal"
        android:textColor="@color/text_on_primary"/>

</LinearLayout>
