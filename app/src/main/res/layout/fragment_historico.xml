<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meus orçamentos"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"/>

    <!-- Descrição -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Consulte os serviços já orçados."
        android:textSize="15sp"
        android:textColor="@color/text_secondary"/>
    <!-- 3. MENSAGEM QUANDO NÃO HOUVER ORÇAMENTOS -->


    <Button
        android:id="@+id/btnLimparHistorico"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="Limpar todo o histórico"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#B3261E"/>

    <TextView
        android:id="@+id/txtHistoricoVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Você ainda não possui orçamentos.\nCrie seu primeiro orçamento para começar!"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"/>

    <!-- Lista de orçamentos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOrcamentos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"/>

</LinearLayout>
