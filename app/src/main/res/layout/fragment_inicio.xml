<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seu trabalho tem valor."
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="29sp"/>

        <!-- Descrição -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Transforme custos em orçamentos mais inteligentes."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"/>

        <!-- Card principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUA HORA DE TRABALHO"
                android:textSize="13sp"
                android:textColor="@color/accent_lime"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtValorHora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="R$ 40,00/h"
                android:textColor="@color/text_on_primary"
                android:textSize="36sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnAjustarPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Ajustar perfil"
                android:textColor="@color/primary_teal"
                android:backgroundTint="@color/surface"/>

        </LinearLayout>

        <!-- Meta mensal -->
        <TextView
            android:id="@+id/txtMetaMensal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Meta mensal: R$ 3.000"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Novo orçamento -->
        <Button
            android:id="@+id/btnNovoOrcamento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="+ CRIAR NOVO ORÇAMENTO"
            android:textColor="@color/text_on_primary"
            android:backgroundTint="@color/accent_blue"/>

        <!-- Serviços -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Serviços disponíveis"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:text="Instalação de Split  →"
            android:textSize="18sp"
            android:textColor="@color/text_primary"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="20dp"
            android:background="@drawable/bg_card"
            android:text="Higienização preventiva  →"
            android:textSize="18sp"
            android:textColor="@color/text_primary"/>

    </LinearLayout>
</ScrollView>
