<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <!-- CONTAINER PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ====================================== -->
        <!-- CABEÇALHO -->
        <!-- ====================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVoltarTela"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/text_primary"
                android:contentDescription="Voltar para tela anterior"
                android:scaleType="centerInside"/>

            <TextView
                android:id="@+id/txtTituloOrcamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Novo orçamento"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

        </LinearLayout>

        <!-- ====================================== -->
        <!-- ETAPA 1: SERVIÇO E CLIENTE -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/etapaUm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Etapa 1 de 3"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_teal"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="1. Serviço e cliente"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Informe o serviço, o cliente e o tempo estimado."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <!-- TIPO DE SERVIÇO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tipo de serviço"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbInstalacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Instalação de Split"
                    android:textColor="@color/text_primary"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbHigienizacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Higienização preventiva"
                    android:textColor="@color/text_primary"/>

            </RadioGroup>

            <!-- NOME DO CLIENTE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Dados do cliente"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/edtCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Nome do cliente"
                android:inputType="textPersonName"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- HORAS ESTIMADAS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tempo de execução"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/edtHorasServico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Horas estimadas de execução"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- AVANÇAR PARA ENDEREÇO -->

            <Button
                android:id="@+id/btnContinuar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="Continuar"
                android:textColor="@color/text_on_primary"
                android:backgroundTint="@color/accent_blue"/>

        </LinearLayout>

        <!-- ====================================== -->
        <!-- ETAPA 2: LOCALIZAÇÃO DO SERVIÇO -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/etapaEndereco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Etapa 2 de 3"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_teal"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2. Localização do serviço"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Informe o CEP para buscar o endereço automaticamente."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <!-- CEP -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="CEP do cliente"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/edtCep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Digite o CEP (8 dígitos)"
                android:inputType="number"
                android:maxLength="8"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- BOTÃO DE CONSULTA VIACEP -->

            <Button
                android:id="@+id/btnBuscarCep"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Buscar endereço"
                android:textColor="@color/text_on_teal"
                android:backgroundTint="@color/primary_teal"/>

            <!-- INFORMAÇÕES DO ENDEREÇO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Dados do endereço"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Confira os dados encontrados ou preencha manualmente."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

            <!-- RUA -->

            <EditText
                android:id="@+id/edtLogradouro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Rua / Logradouro"
                android:inputType="textPostalAddress"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <EditText
                android:id="@+id/edtNumero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Número do imóvel"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- COMPLEMENTO -->

            <EditText
                android:id="@+id/edtComplemento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Complemento (opcional)"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- BAIRRO -->

            <EditText
                android:id="@+id/edtBairro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Bairro"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- CIDADE -->

            <EditText
                android:id="@+id/edtCidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Cidade"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- UF -->

            <EditText
                android:id="@+id/edtUf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Estado (UF)"
                android:maxLength="2"
                android:inputType="textCapCharacters"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- VOLTAR PARA A ETAPA 1 -->

            <Button
                android:id="@+id/btnVoltarEndereco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Voltar"
                android:textColor="@color/text_primary"/>

            <!-- AVANÇAR PARA A ETAPA 3 -->

            <Button
                android:id="@+id/btnContinuarEndereco"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Continuar"
                android:textColor="@color/text_on_primary"
                android:backgroundTint="@color/accent_blue"/>

        </LinearLayout>

        <!-- ====================================== -->
        <!-- ETAPA 3: CUSTOS DO SERVIÇO -->
        <!-- ====================================== -->

        <LinearLayout
            android:id="@+id/etapaDois"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Etapa 3 de 3"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_teal"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="3. Custos do serviço"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Informe os custos envolvidos no atendimento."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <!-- DISTÂNCIA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Deslocamento"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/edtDistancia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Distância total em km"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- MATERIAIS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Materiais"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/edtMateriais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Custo dos materiais (R$)"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- OUTROS CUSTOS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Custos adicionais"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/edtOutrosCustos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Outros custos (R$)"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"/>

            <!-- VOLTAR PARA ENDEREÇO -->

            <Button
                android:id="@+id/btnVoltarEtapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Voltar"
                android:textColor="@color/text_primary"/>

            <!-- VISUALIZAR RESULTADO -->

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Visualizar orçamento"
                android:textColor="@color/text_on_teal"
                android:backgroundTint="@color/primary_teal"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
